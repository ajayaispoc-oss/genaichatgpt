{
  "entities": {
    "leads": {
      "title": "Enrollment Leads",
      "description": "Potential students who have filled out the enrollment form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the lead."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the lead."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the lead."
        },
        "city": {
          "type": "string",
          "description": "City of the lead (optional)."
        },
        "status": {
          "type": "string",
          "enum": ["fresher", "professional", "working_professional"],
          "description": "Professional status of the lead."
        },
        "role": {
          "type": "string",
          "description": "Current role or designation of the lead."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the lead was created."
        }
      },
      "required": ["name", "email", "phone", "status", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "leads",
      "description": "Collection of enrollment leads."
    }
  }
}
